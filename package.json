{
  "name": "devops-ci-workflow",
  "version": "0.1.0",
  "description": "A small GitHub Actions CI workflow template for a Node project.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthews-wong/devops-ci-workflow.git"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "lint": "node scripts/check-syntax.mjs",
    "lint:actions": "actionlint",
    "validate": "npm run lint && npm run test:coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}